# OmniRoute — Wibx-LABS pilot .env template
#
#   cp env.template <fork>/.env    then fill the three secrets below.
#
# Only the variables we deliberately set are here. Everything else stays at the
# fork's defaults — see the fork's .env.example for the full contract.
# Rules and rationale: wibx/README.md
#
# DO NOT COMMIT the filled copy. It holds provider keys.

# ── 1. Secrets — all three required before first boot ────────────────────────
# JWT_SECRET:            openssl rand -base64 48
# API_KEY_SECRET:        openssl rand -hex 32
# STORAGE_ENCRYPTION_KEY: openssl rand -hex 32
#
# STORAGE_ENCRYPTION_KEY must be set BEFORE the first credential is added. Our
# fork's encrypt() fails closed when it is missing, so an unset key surfaces as
# an error rather than silently writing plaintext provider keys to SQLite.
# Never use STORAGE_ENCRYPTION_OPTOUT=1 to work around that error.
JWT_SECRET=
API_KEY_SECRET=
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# Closes the unauthenticated bootstrap window. With no password, no OIDC and no
# INITIAL_PASSWORD, isAuthRequired() returns false for loopback requests until
# setup completes. Set it; the shipped default is literally CHANGEME.
INITIAL_PASSWORD=

# ── 2. Ports ─────────────────────────────────────────────────────────────────
# Split mode: the dashboard holds the privileged routes, the API port is the only
# thing colleagues ever touch. Host-side binding is in docker-compose.override.yml.
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
API_HOST=0.0.0.0          # inside the container only; the host bind is loopback

# ── 3. Memory ────────────────────────────────────────────────────────────────
# Runtime V8 heap. The Dockerfile's runner stage defaults this to 1024, which is
# fine for a green-only gateway. Set it EXPLICITLY anywhere the container is
# memory-capped: Node reads the HOST's RAM, not the cgroup limit, so a heuristic
# can oversize the heap and get the container OOM-killed (upstream #2939).
# Rule of thumb: about half the box's RAM.
OMNIROUTE_MEMORY_MB=1024

# NOTE — build-time memory is a SEPARATE knob and is not read from this file.
# The builder stage hardcodes ARG OMNIROUTE_BUILD_MEMORY_MB=4096 because the
# webpack production pass needs more than V8's ~2 GB default for a codebase this
# size (upstream #4076). On a Docker VM with 5-6 GB that leaves almost nothing
# for the daemon — expect `docker ps` to stall during the build, and a possible
# "JavaScript heap out of memory". If the build dies, either raise the VM's RAM
# (Docker Desktop → Settings → Resources) or lower the ceiling:
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.override.yml \
#     build --build-arg OMNIROUTE_BUILD_MEMORY_MB=3072
#
# Lowering it trades build speed for headroom; too low and the prerender phase
# fails outright. Raising the VM is the better fix when it is available.

# ── 4. Rate limiting ─────────────────────────────────────────────────────────
# The prod compose ships a Redis service; point the limiter at it. Left unset,
# OmniRoute uses an in-memory limiter that resets on every restart.
REDIS_URL=redis://redis:6379

# ── 5. Anti-detection — deliberately unset ───────────────────────────────────
# CLI_COMPAT_* reorder headers and JSON fields to match official CLI signatures.
# Upstream describes them as "reducing account flagging risk" — they exist to
# evade detection. Off by default; keep them off. Under a green-only policy
# there is nothing to disguise: API-key providers are being used as intended.
#
#   CLI_COMPAT_ALL, CLI_COMPAT_CLAUDE, CLI_COMPAT_CODEX, CLI_COMPAT_GITHUB,
#   CLI_COMPAT_CURSOR, CLI_COMPAT_ANTIGRAVITY, CLI_COMPAT_KIMI_CODING,
#   CLI_COMPAT_KILOCODE, CLI_COMPAT_CLINE
#
# Same for the TLS-interception inspector:
INSPECTOR_TLS_INTERCEPT=false
INSPECTOR_HTTP_PROXY_AUTOSTART=false
INSPECTOR_MASK_SECRETS=true

# ── 6. Providers — 🟢 green only ─────────────────────────────────────────────
# Add credentials through Dashboard → Providers, not here; they land encrypted in
# SQLite instead of sitting plaintext in this file. A provider with no credential
# cannot route, so for keyed providers the empty state is the allowlist.
#
# That reasoning does NOT extend to the keyless ones — they need no credential, so
# an empty config was an open door rather than a closed one. See below.
#
# Approved (documented API, key you signed up for, published free tier):
#   Groq · Gemini · DeepSeek · Mistral · SiliconFlow · Cerebras
#   Cloudflare Workers AI · Vertex · Kimi · GLM · OpenRouter
#
# NOT approved — and refused in code (PR #5), not by anyone remembering:
#   🟡 first-party subscriptions (OAUTH_PROVIDERS, 23) — blocked unless named in
#      OMNIROUTE_ALLOW_SUBSCRIPTION below. The decision was "revisit later".
#   🔴 web-session executors (WEB_COOKIE_PROVIDERS, 31) — blocked with no escape
#      hatch at all. The decision was "never".
#
# OMNIROUTE_ALLOW_SUBSCRIPTION=
#
# ── 7. Keyless providers — blocked by default, leave this unset ──────────────
# Was a manual "remove them after first boot" step; it is now enforced in code
# (OmniRoute#3). All nine keyless providers — opencode, felo-web, duckduckgo-web,
# theoldllm, chipotle, veoaifree-web, mimocode, auggie, aihorde — are blocked
# unless named here, comma-separated, by id or alias.
#
# Leave it unset. Upstream ships these needing no credential, so an untouched
# install used to answer `auto` by sending prompts to a third party nobody
# configured. Green-only is about ban risk; this one is about our source code —
# and aihorde in particular dispatches to volunteer-run GPUs.
#
# Setting it is a deliberate, reviewable act. verify.sh [6] fails if it is set.
# OMNIROUTE_ALLOW_NOAUTH=
